[Icon Theme]
Name=Definitivo
Comment=Tema personalizado
Inherits=Papirus-Dark,Papirus,Adwaita,hicolor

FollowsColorScheme=true

Directories=places/scalable,places/symbolic,apps/scalable

[places/scalable]
Context=Places
Size=128
