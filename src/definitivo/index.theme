[Icon Theme]
Name=Definitivo
Comment=Tema personalizado
Inherits=Papirus-Dark,Papirus,Adwaita,hicolor
FollowsColorScheme=true

Directories=places/scalable,places/symbolic,apps/scalable

[places/scalable]
Context=Places
Size=64
MinSize=32
MaxSize=512
Type=Scalable

[places/symbolic]
Context=Places
Size=16
MinSize=8
MaxSize=32
Type=Scalable

[apps/scalable]
Context=Apps
Size=128
MinSize=16
MaxSize=512
Type=Scalable

# Extra entries for better GTK 4 compatibility
[16x16]
Size=16
Type=Scalable
Context=Places

[32x32]
Size=32
Type=Scalable
Context=Places

[48x48]
Size=48
Type=Scalable
Context=Places

[64x64]
Size=64
Type=Scalable
Context=Places
